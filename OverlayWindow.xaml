<Window x:Class="GameTimer.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:GameTimer"
        Title="게임 타이머"
        Width="220" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        ShowActivated="False"
        FontFamily="Malgun Gothic, Segoe UI" Foreground="White">
    <Border x:Name="RootBorder" CornerRadius="8" Padding="8,4,8,8" Background="#B3101012"
            MouseLeftButtonDown="RootBorder_MouseLeftButtonDown">
        <StackPanel>
            <!-- 헤더 -->
            <Grid Height="24">
                <TextBlock Text="⏱ 타이머" FontSize="12" Opacity="0.75" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Hidden"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMouseOver, ElementName=RootBorder}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <Button Content="⚙" ToolTip="설정" Style="{StaticResource IconButton}" FontSize="13"
                            Click="SettingsButton_Click"/>
                    <Button Content="✕" ToolTip="종료" Style="{StaticResource IconButton}" FontSize="12"
                            Click="CloseButton_Click"/>
                </StackPanel>
            </Grid>

            <!-- 스톱워치 -->
            <Border x:Name="StopwatchBorder" CornerRadius="4" Padding="6,4" Margin="0,2,0,0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="TextElement.Foreground" Value="{StaticResource DimBrush}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                <Setter Property="TextElement.Foreground" Value="White"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Name}" FontSize="12" Margin="0,0,6,0"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Column="1" Text="{Binding ElapsedText}" FontSize="16"
                               FontWeight="Bold" FontFamily="Consolas, Segoe UI"
                               VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="4,0,0,0">
                        <Button FontSize="12" FontFamily="Segoe UI Symbol" Click="StopwatchToggle_Click">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                    <Setter Property="Content" Value="▶"/>
                                    <Setter Property="ToolTip" Value="시작"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                            <Setter Property="Content" Value="⏸"/>
                                            <Setter Property="ToolTip" Value="일시정지"/>
                                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="↺" ToolTip="초기화" Style="{StaticResource IconButton}" FontSize="13"
                                FontFamily="Segoe UI Symbol" Click="StopwatchReset_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock x:Name="EmptyHint" Text="⚙에서 타이머를 추가하세요" FontSize="11"
                       Foreground="{StaticResource DimBrush}" Margin="0,4,0,2" TextWrapping="Wrap"/>

            <ItemsControl x:Name="RowsList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:TimerRow}">
                        <Border x:Name="RowBorder" CornerRadius="4" Padding="6,4" Margin="0,2,0,0"
                                Background="Transparent" TextElement.Foreground="White">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Background="#26FFFFFF" CornerRadius="3" Padding="5,1" MinWidth="24"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding KeyName}" FontSize="11" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12" Margin="6,0"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="2" Text="{Binding RemainingText}" FontSize="16"
                                               FontWeight="Bold" FontFamily="Consolas, Segoe UI"
                                               VerticalAlignment="Center"/>
                                </Grid>
                                <Grid Height="3" Margin="0,4,0,0">
                                    <Border Background="#1FFFFFFF" CornerRadius="1.5"/>
                                    <Border x:Name="Bar" Background="{StaticResource AccentBrush}" CornerRadius="1.5"
                                            RenderTransformOrigin="0,0.5">
                                        <Border.RenderTransform>
                                            <ScaleTransform ScaleX="{Binding Progress}"/>
                                        </Border.RenderTransform>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding State}" Value="{x:Static local:RowState.Idle}">
                                <Setter TargetName="RowBorder" Property="TextElement.Foreground" Value="{StaticResource DimBrush}"/>
                                <Setter TargetName="Bar" Property="Visibility" Value="Hidden"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding State}" Value="{x:Static local:RowState.Warning}">
                                <Setter TargetName="RowBorder" Property="TextElement.Foreground" Value="{StaticResource WarnBrush}"/>
                                <Setter TargetName="Bar" Property="Background" Value="{StaticResource WarnBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding FlashOn}" Value="True">
                                <Setter TargetName="RowBorder" Property="Background" Value="#80FFA040"/>
                                <Setter TargetName="RowBorder" Property="TextElement.Foreground" Value="White"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>
</Window>
