<Window x:Class="GameTimer.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:GameTimer"
        Title="게임 타이머 설정"
        Width="614" Height="600" MinWidth="574" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PanelBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Malgun Gothic, Segoe UI" FontSize="13"
        PreviewKeyDown="Window_PreviewKeyDown" Deactivated="Window_Deactivated">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 스톱워치 이름 -->
        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="⏱ 스톱워치 이름" VerticalAlignment="Center"/>
            <TextBox x:Name="StopwatchNameBox" Grid.Column="1" Margin="6,0,0,0" Style="{StaticResource DarkTextBox}"/>
        </Grid>

        <!-- 표 헤더 -->
        <Grid Grid.Row="1" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="44"/>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="36"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="사용" Foreground="{StaticResource DimBrush}"/>
            <TextBlock Grid.Column="1" Text="키" Foreground="{StaticResource DimBrush}"/>
            <TextBlock Grid.Column="2" Text="이름" Margin="6,0" Foreground="{StaticResource DimBrush}"/>
            <TextBlock Grid.Column="3" Text="시간 (mm:ss)" Foreground="{StaticResource DimBrush}" FontSize="11"
                       VerticalAlignment="Bottom"/>
            <TextBlock Grid.Column="4" Text="알림음" Margin="6,0,0,0" Foreground="{StaticResource DimBrush}"/>
        </Grid>

        <!-- 타이머 목록 -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <ItemsControl x:Name="RowsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:EditRow}">
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="44"/>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="36"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Left" VerticalAlignment="Center"
                                          IsChecked="{Binding Enabled, Mode=TwoWay}" ToolTip="사용 / 사용 안 함"/>
                                <Button x:Name="KeyButton" Grid.Column="1" Content="{Binding KeyText}" Style="{StaticResource DarkButton}"
                                        Padding="6,4" HorizontalContentAlignment="Center"
                                        Click="KeyButton_Click" ToolTip="클릭 후 등록할 키를 누르세요 (Esc: 취소)"/>
                                <TextBox x:Name="NameBox" Grid.Column="2" Margin="6,0" Style="{StaticResource DarkTextBox}"
                                         Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBox x:Name="TimeBox" Grid.Column="3" Style="{StaticResource DarkTextBox}"
                                         HorizontalContentAlignment="Center"
                                         Text="{Binding TimeText, UpdateSourceTrigger=PropertyChanged}"/>
                                <ComboBox x:Name="SoundBox" Grid.Column="4" Margin="6,0,0,0" Style="{StaticResource DarkComboBox}"
                                          ItemsSource="{x:Static local:Chime.Names}"
                                          SelectedIndex="{Binding Sound, Mode=TwoWay}"/>
                                <Button Grid.Column="5" Content="🗑" ToolTip="삭제" Style="{StaticResource IconButton}"
                                        HorizontalAlignment="Center" FontFamily="Segoe UI Symbol"
                                        Click="DeleteButton_Click"/>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding KeyError}" Value="True">
                                    <Setter TargetName="KeyButton" Property="BorderBrush" Value="{StaticResource ErrorBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsCapturing}" Value="True">
                                    <Setter TargetName="KeyButton" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                    <Setter TargetName="KeyButton" Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding TimeError}" Value="True">
                                    <Setter TargetName="TimeBox" Property="BorderBrush" Value="{StaticResource ErrorBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Enabled}" Value="False">
                                    <Setter TargetName="KeyButton" Property="Opacity" Value="0.45"/>
                                    <Setter TargetName="NameBox" Property="Opacity" Value="0.45"/>
                                    <Setter TargetName="TimeBox" Property="Opacity" Value="0.45"/>
                                    <Setter TargetName="SoundBox" Property="Opacity" Value="0.45"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Content="+ 타이머 추가" Style="{StaticResource DarkButton}" HorizontalAlignment="Left"
                        Click="AddButton_Click"/>
            </StackPanel>
        </ScrollViewer>

        <!-- 검증 메시지 -->
        <TextBlock x:Name="ErrorText" Grid.Row="3" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap"
                   Margin="0,8,0,0" FontSize="12"/>

        <!-- 소리 크기 -->
        <Grid Grid.Row="4" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="40"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="🔊 소리 크기" VerticalAlignment="Center"/>
            <Slider x:Name="VolumeSlider" Grid.Column="1" Minimum="0" Maximum="100"
                    IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="2" Text="{Binding Value, ElementName=VolumeSlider, StringFormat={}{0:0}}"
                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
            <Button Grid.Column="3" Content="미리듣기" Style="{StaticResource DarkButton}" Margin="10,0,0,0"
                    Padding="10,3" Click="PreviewButton_Click"/>
        </Grid>

        <!-- 투명도 -->
        <Grid Grid.Row="5" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="40"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="오버레이 투명도" VerticalAlignment="Center"/>
            <Slider x:Name="OpacitySlider" Grid.Column="1" Minimum="20" Maximum="100"
                    IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="2" Text="{Binding Value, ElementName=OpacitySlider, StringFormat={}{0:0}%}"
                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </Grid>

        <!-- 하단 버튼 -->
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="취소" Style="{StaticResource DarkButton}" MinWidth="80" Click="CancelButton_Click"
                    HorizontalContentAlignment="Center"/>
            <Button x:Name="SaveButton" Content="저장" Style="{StaticResource AccentButton}" MinWidth="80"
                    Margin="8,0,0,0" Click="SaveButton_Click" HorizontalContentAlignment="Center"/>
        </StackPanel>
    </Grid>
</Window>
