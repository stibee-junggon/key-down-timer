<Window x:Class="GameTimer.RenameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="스톱워치 이름"
        Width="300" SizeToContent="Height" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True" WindowStartupLocation="Manual"
        Background="{StaticResource PanelBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Malgun Gothic, Segoe UI" FontSize="13"
        Loaded="Window_Loaded">
    <StackPanel Margin="16">
        <TextBox x:Name="NameBox" Style="{StaticResource DarkTextBox}"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="취소" Style="{StaticResource DarkButton}" MinWidth="80" IsCancel="True"
                    HorizontalContentAlignment="Center"/>
            <Button Content="저장" Style="{StaticResource AccentButton}" MinWidth="80" IsDefault="True"
                    Margin="8,0,0,0" Click="SaveButton_Click" HorizontalContentAlignment="Center"/>
        </StackPanel>
    </StackPanel>
</Window>
